rules_version = '2';

// Reglas de Firebase Storage — Rapidiya.
// NOTA: hoy la app NO usa Storage (las imágenes de productos van por URL
// externa en url_imagen). Estas reglas quedan listas para cuando se agregue
// subida directa de fotos desde el panel admin.

service firebase.storage {
  match /b/{bucket}/o {

    function esAdmin() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function appCheckValida() {
      return request.app != null;
    }

    // Productos y promos: lectura pública, escritura SOLO admin + App Check.
    match /productos/{id} {
      allow read: if true;
      allow write: if esAdmin() && appCheckValida()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /promos/{id} {
      allow read: if true;
      allow write: if esAdmin() && appCheckValida()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Usuarios: cada uno solo su propia foto (por uid).
    // Lectura pública (el cliente muestra la foto del usuario en orders, etc.).
    match /usuarios/{uid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && appCheckValida()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Sorteos: lectura pública, escritura SOLO admin + App Check.
    match /sorteos/{id} {
      allow read: if true;
      allow write: if esAdmin() && appCheckValida()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Default: DENY
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
